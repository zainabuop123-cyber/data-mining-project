# Copy this file to .env and fill in your real values. Never commit .env.

# --- Vision AI service ------------------------------------------------------
# Any OpenAI-compatible multimodal (vision) chat-completions endpoint works.
VISION_API_KEY=
VISION_MODEL=qwen/qwen3.6-27b
VISION_BASE_URL=https://api.groq.com/openai/v1
VISION_TIMEOUT_SECONDS=60
VISION_MAX_RETRIES=2

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite:///documents.db

# --- File handling -------------------------------------------------------
MAX_FILE_SIZE_MB=15
PDF_RENDER_DPI=200

# --- Validation --------------------------------------------------------------
CALCULATION_TOLERANCE=0.01

# --- Misc ----------------------------------------------------------------
DEBUG=false
